{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh tools/notification-acceptance/web/preview-build.sh",
  "outputDirectory": "preview-dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/acceptance/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; connect-src 'self' https://bfvybxkjxilntjgndsrm.supabase.co; worker-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
