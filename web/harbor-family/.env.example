VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Optional. The PUBLIC half of the backend's VAPID pair (the same value as the VAPID_PUBLIC_KEY function secret).
# Without it the app runs normally but offers no browser notifications. Never put the private key here.
VITE_VAPID_PUBLIC_KEY=
